{
    "name": "codelabs/laravel-ai",
    "description": "Code-Labs self-hosted LLM (ai.code-labs.nl) as a provider for the Laravel AI SDK, with key usage and budget reporting.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/CodeLabs-BV/laravel-ai",
    "support": {
        "issues": "https://github.com/CodeLabs-BV/laravel-ai/issues",
        "source": "https://github.com/CodeLabs-BV/laravel-ai"
    },
    "require": {
        "php": "^8.5",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "CodeLabs\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeLabs\\Ai\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeLabs\\Ai\\CodeLabsAiServiceProvider"
            ],
            "aliases": {
                "CodeLabsAi": "CodeLabs\\Ai\\Facades\\CodeLabsAi"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
